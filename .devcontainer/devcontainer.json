{
  "name": "Node + Python AI Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ]
    }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Frontend",
      "onAutoForward": "notify",
      "elevationRequirement": "none"
    },
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd api/node && npm install ; cd ../fastapi && pip install --no-cache-dir --break-system-packages -r requirements.txt || echo 'pip install failed, run manually'"
}