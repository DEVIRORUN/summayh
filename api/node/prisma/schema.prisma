// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// api/node/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS HERE

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  COMPLETED
  FAILED
  CANCELLED
  ACTIVE
  DISPUTED // new
  REFUNDED // new
}

enum Service {
  DIGITAL
  PHYSICAL
}

enum State {
  ACTIVE
  PAUSED
  INACTIVE
}

enum TierLabel {
  BASIC
  STANDARD
  PREMIUM
}

enum RequirementInputType {
  FREE_TEXT
  MULTIPLE_CHOICE
  FILE_UPLOAD
  YES_NO
}

enum DisputeStatus {
  OPEN
  AI_REVIEWED
  MANUAL_REVIEWED // Might wanna add this
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum DisputeReason {
  WORK_NOT_DELIVERED
  WORK_NOT_AS_DESCRIBED
  SELLER_UNRESPONSIVE
  QUALITY_ISSUES
  OTHER
}

enum VerificationStat {
  VERIFIED
  PENDING
  REJECTED
  NOTVERIFIED
}

enum StatusFounders {
  PENDING
  SUCCESS
  FAILED
}

enum GigStatusFlag {
  NORMAL
  WARNING
  SHADOWBAN
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum AgentName {
  DISPUTE_RESOLUTION
  REVIEW_SPAM_DETECTION
  PROFILE_CLONER
  AGENTIC_SEARCH
  SEMANTIC_MATCH
  EMBEDDING_GENERATION
  BIO_GENERATION
}

enum ProSource {
  FOUNDERS
  SUSBSCRIPTION
}

// model TestConnection {
//   id        String   @id @default(uuid())
//   createdAt DateTime @default(now())
//   status    String   @default("Successfully Connected!")
// }

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  name               String
  username           String?
  university         String           @default("Unkown University")
  dateOfBirth        DateTime
  phoneNumber        String?          @unique
  isPhoneVerified    Boolean          @default(false)
  role               Role             @default(BUYER)
  isBanned           Boolean          @default(false)
  tokenVersion       Int              @default(0)
  banReason          String?
  verificationStatus VerificationStat @default(NOTVERIFIED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relationships
  sellerProfile   SellerProfile?
  orders          Order[]
  otpVerification OTPVerification?
  reviews         Review[]
  dispute         Dispute[]
  invoices        Invoice[]
}

model SellerProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  sellerUsername         String?  @unique
  bio                    String
  skills                 String[]
  rating                 Float    @default(0.0)
  paystackSubaccountCode String?
  totalReviews           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  phoneNumber            String?  @unique

  // Stats
  isOnline     Boolean   @default(false)
  lastActiveAt DateTime?

  // Pro field
  isPro         Boolean   @default(false)
  proSource ProSource?
  founderBadge  Boolean   @default(false)
  founderPassAt DateTime?

  proexpiresAt DateTime?

  // AI
  aiBio String?

  // Review
  avgRating Float @default(0)

  // Relationships
  reviews               Review[]
  user                  User                   @relation(fields: [userId], references: [id])
  gigs                  Gig[]
  order                 Order[]
  dispute               Dispute[]
  foundersPassPurchases FoundersPassPurchase[]
  invoices              Invoice[]
}

model FoundersPassPurchase {
  id              String         @id @default(uuid())
  sellerId        String         @unique // JUST ADDED THIS FOR CONSTARINT FOR OEN SELLE PER PASS
  amount          Float
  paymentRefernce String         @unique
  status          StatusFounders @default(PENDING) // PENDING | SUCCESS | FAILED
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model FoundersPassConfig {
  id         String   @id @default(uuid())
  priceNaira Float
  maxPasses  Int      @default(250)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  updatedBy  String? // admin userId, optional audit trail
}

model Gig {
  id           String   @id @default(uuid())
  sellerId     String
  categoryId   String // Changed from String? to required once you migrate
  title        String
  description  String
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  service      Service  @default(DIGITAL)
  state        State    @default(ACTIVE)
  coverImage   String?
  avgRating    Float    @default(0)
  totalReviews Int      @default(0)

  // Embedding
  embedding Unsupported("vector(768)")?

  // Ranking
  baseRankingScore Int           @default(0)
  statusFlag       GigStatusFlag @default(NORMAL)
  isRookiePeriod   Boolean       @default(true)
  rookieExpiredAt  DateTime?

  // Relationships
  seller               SellerProfile            @relation(fields: [sellerId], references: [id])
  category             Category                 @relation(fields: [categoryId], references: [id])
  requirementTemplates GigRequirementTemplate[]
  tiers                GigTier[]
  orders               Order[]
  reviews              Review[]
  gigStats             GigStats?
}

model GigStats {
  id          String   @id @default(uuid())
  gigId       String   @unique
  impressions Int      @default(0)
  clicks      Int      @default(0)
  updatedAt   DateTime @updatedAt

  // relations
  gig Gig @relation(fields: [gigId], references: [id])
}

model GigTier {
  id            String    @id @default(uuid())
  gigId         String
  label         TierLabel
  customName    String?
  description   String
  price         Float
  deliveryDays  Int
  revisionCount Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // Relationships
  gig             Gig                 @relation(fields: [gigId], references: [id], onDelete: Cascade)
  quantityPricing TierQuantityPrice[]
  orders          Order[]

  @@unique([gigId, label]) // a gig can only have ONE TIER not label duplicates
}

model GigRequirementTemplate {
  id         String               @id @default(uuid())
  gigId      String
  question   String // "What is your brand name"
  inputType  RequirementInputType @default(FREE_TEXT)
  options    String[] // Only when inpput_tyoe is multiple
  isRequired Boolean              @default(true)
  order      Int                  @default(0)
  createdAt  DateTime             @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)
}

model TierQuantityPrice {
  id                 String   @id @default(uuid())
  gigTierId          String
  quantity           Int
  totalPrice         Float
  createdAt          DateTime @default(now())
  discountPercentage Float

  gigTier GigTier @relation(fields: [gigTierId], references: [id], onDelete: Cascade)

  @@unique([gigTierId, quantity]) // no duplicate quantity bands per tier
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique // e.g., "programming-tech" or "web-development" for clean URLs
  parentId  String? // If this is null, it's a Main Category. If it has an ID, it's a Subcategory!
  createdAt DateTime @default(now())

  // Self-referencing relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  // The connection back to your Gigs
  gigs Gig[]
}

model Order {
  id        String @id @default(uuid())
  sellerId  String
  buyerId   String
  gigId     String
  gigTierId String // the tier that was ordered

  // frozen at order time (SNAPSHOT)
  tierLabelSnapshot     TierLabel
  tierNameSnapshot      String? // customName at time of order, if any
  tierDescription       String
  unitPriceSnapshot     Float
  quantity              Int       @default(1)
  totalPrice            Float // final amount actually charged (unitPrice/bulk price × quantity, frozen)
  commission            Float?
  deliveryDaysSnapshot  Int
  revisionCountSnapshot Int
  requirements          Json?

  cancelReason String?

  status                  OrderStatus @default(PENDING)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
  cancelledAt             DateTime?
  requirementsSubmittedAt DateTime?
  paymentReference        String?     @unique

  // Relationships
  buyer   User          @relation(fields: [buyerId], references: [id])
  seller  SellerProfile @relation(fields: [sellerId], references: [id])
  gigTier GigTier       @relation(fields: [gigTierId], references: [id])
  gig     Gig           @relation(fields: [gigId], references: [id])
  dispute Dispute?
  review  Review?
}

model OTPVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique // only one review is allowed of course, at DB level enforced
  gigId     String
  buyerId   String
  sellerId  String
  rating    Int
  comment   String
  isFlagged Boolean  @default(false) // spam detection flag (FastAPI)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order         @relation(fields: [orderId], references: [id])
  gig    Gig           @relation(fields: [gigId], references: [id])
  buyer  User          @relation(fields: [buyerId], references: [id])
  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String        @unique // one dispute max
  buyerId      String
  sellerId     String
  reason       DisputeReason
  description  String
  evidenceUrls String[]      @default([])
  status       DisputeStatus @default(OPEN)

  // AI fields (FastAPI work)
  aiSummary        String?
  aiRecommendation String? // "favour_buyer" | "favour_seller" | "escalate"
  aiConfidence     Float?

  // Resolution (populated by admin)
  resolution String?
  resolvedAt DateTime?
  resolvedby String? // admin userId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order  Order         @relation(fields: [orderId], references: [id])
  buyer  User          @relation(fields: [buyerId], references: [id])
  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model Invoice {
  id               String        @id @default(uuid())
  sellerId         String
  clientName       String
  clientEmail      String? // may not be known until checkout, buyer fills it in
  description      String
  amount           Float
  status           InvoiceStatus @default(PENDING)
  paymentReference String?       @unique
  buyerId          String? // linked once the buyer pays and their User record is created/matched
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  expiresAt        DateTime?

  // Relations
  seller SellerProfile @relation(fields: [sellerId], references: [id])
  buyer  User?         @relation(fields: [buyerId], references: [id])
}

model AgentDecision {
  id           String    @id @default(uuid())
  agentName    AgentName
  entityId     String // the ID of whatever it acted on (disputeId, reviewId, gigId)
  entityType   String // "Dispute" | "Review" | "Gig" — human-readable label for the UI
  decision     String // "favour_buyer" | "spam" | "profile_generated" etc — whatever the agent output
  confidence   Float? // 0.0–1.0, null if the agent doesn't produce a confidence score
  reasoning    String? // the AI's own explanation, if it produced one
  inputSummary String? // short human-readable snapshot of what was fed in
  createdAt    DateTime  @default(now())

  @@index([agentName])
  @@index([createdAt])
}
