// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// api/node/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS HERE

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  COMPLETED
  FAILED
  CANCELLED
  ACTIVE
  DISPUTED // new
  REFUNDED // new
}

enum Service {
  DIGITAL
  PHYSICAL
}

enum GigDeliveryMode {
  DIGITAL
  LIVE
  PHYSICAL
}

enum State {
  DRAFT
  ACTIVE
  PAUSED
  INACTIVE
}

enum TierLabel {
  BASIC
  STANDARD
  PREMIUM
}

enum RequirementInputType {
  FREE_TEXT
  MULTIPLE_CHOICE
  FILE_UPLOAD
  YES_NO
}

enum DisputeStatus {
  OPEN
  AI_REVIEWED
  UNDER_REVIEW
  MANUAL_REVIEWED // Might wanna add this
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum SessionDisputeStatus {
  OPEN
  AI_REVIEWED
  UNDER_REVIEW
  MANUAL_REVIEWED // Might wanna add this
  RESOLVED_BUYER
  RESOLVED_SELLER
  DISMISSED
  ESCALATED // handed off to order-level Dispute
}

enum DisputeReason {
  WORK_NOT_DELIVERED
  WORK_NOT_AS_DESCRIBED
  SELLER_UNRESPONSIVE
  QUALITY_ISSUES
  OTHER
}

enum VerificationStat {
  VERIFIED
  PENDING
  REJECTED
  NOTVERIFIED
}

enum StatusFounders {
  PENDING
  SUCCESS
  FAILED
}

enum GigStatusFlag {
  NORMAL
  WARNING
  SHADOWBAN
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum AgentName {
  DISPUTE_RESOLUTION
  REVIEW_SPAM_DETECTION
  PROFILE_CLONER
  AGENTIC_SEARCH
  SEMANTIC_MATCH
  EMBEDDING_GENERATION
  BIO_GENERATION
}

enum ProSource {
  FOUNDERS
  SUBSCRIPTION
}

enum LedgerEntryType {
  EARNING // Landing in seller's
  WITHDRAWAL // To seller's bank account
  REFUND
  FEE // My fee
  ADJUSTMENT // manual/admin correction <--
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CallStatus {
  PENDING
  RINGING
  ACTIVE
  ENDED
  MISSED
}

enum BoardMode {
  DIGITAL
  CAMERA
  RESOURCE
}

enum PurchaseType {
  FULL_COURSE
  SESSION_RANGE
}

enum OvertimeStatus {
  PENDING
  APPROVED
  DECLINED
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum SessionBookingStatus {
  SCHEDULED // bookes in future
  IN_PROGRESS // active
  COMPLETED
  CANCELLED // before start
}

enum SessionOutcome {
  PENDING
  DONE
  BUYER_MISSED
  SELLER_MISSED
  BOTH_MISSED
  DISPUTED // frozen for admin preview
}

enum PackagePayoutStage {
  NONE
  TIER1_RELEASED // 30%
  TIER2_RELEASED // 40% 
  FULLY_RELEASED

  // small pkgs skip only 2 steps
}

enum ProPlanInterval {
  MONTHLY
  YEARLY
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  SESSION_REMINDER
  SESSION_STARTING
  PAYMENT_RECEIVED
  MILESTONE_RECEIVED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  MESSAGE_RECEIVED
  NO_SHOW_FLAGGED
}

model ProPlan {
  id         String          @id @default(uuid())
  name       String
  priceNaira Float
  interval   ProPlanInterval
  isActive   Boolean         @default(true)
  perks      String[] // gon use this for pricing bullet points
  createdAt  DateTime        @default(now())

  subscriptions ProSubscription[]
}

model ProSubscription {
  id               String        @id @default(uuid())
  sellerId         String
  planId           String
  status           InvoiceStatus @default(PENDING)
  paymentReference String?       @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  cancelledAt      DateTime?

  seller SellerProfile @relation(fields: [sellerId], references: [id])
  plan   ProPlan?      @relation(fields: [planId], references: [id])

  @@index([sellerId])
}

// model TestConnection {
//   id        String   @id @default(uuid())
//   createdAt DateTime @default(now())
//   status    String   @default("Successfully Connected!")
// }

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  name               String
  username           String?
  university         String           @default("Unkown University")
  dateOfBirth        DateTime?
  avatar             String?
  isOnline           Boolean?
  phoneNumber        String?          @unique
  isPhoneVerified    Boolean          @default(false)
  role               Role             @default(BUYER)
  isBanned           Boolean          @default(false)
  tokenVersion       Int              @default(0)
  banReason          String?
  verificationStatus VerificationStat @default(NOTVERIFIED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relationships
  sellerProfile        SellerProfile?
  orders               Order[]
  otpVerification      OTPVerification?
  reviews              Review[]
  dispute              Dispute[]
  ledgerEntries        LedgerEntry[]
  invoices             Invoice[]
  testimonialWritten   Testimonial[]
  withdrawals          Withdrawal[]
  messages             Message[]
  conversations        Conversation[]
  conversationsAsUserA Conversation[]     @relation("ConversationsAsUserA")
  conversationsAsUserB Conversation[]     @relation("ConversationsAsUserB")
  CallerSessions       CallSession[]      @relation("CallerSessions")
  CalleeSessions       CallSession[]      @relation("CalleeSessions")
  courseEnrollments    CourseEnrollment[]
  notifications        Notification[]
}

model SellerProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  sellerUsername         String?  @unique
  bio                    String
  skills                 String[]
  rating                 Float    @default(0.0)
  paystackSubaccountCode String?
  totalReviews           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  phoneNumber            String?  @unique
  avatar                 String? // Just about to be added(migartion))

  // Stats
  isOnline     Boolean   @default(false)
  lastActiveAt DateTime?

  // Pro field
  isPro         Boolean    @default(false)
  proSource     ProSource?
  founderBadge  Boolean    @default(false)
  founderPassAt DateTime?

  proExpiresAt DateTime?

  // AI
  aiBio String?

  // Review
  avgRating Float @default(0)

  // Relationships
  reviews               Review[]
  user                  User                   @relation(fields: [userId], references: [id])
  gigs                  Gig[]
  order                 Order[]
  dispute               Dispute[]
  foundersPassPurchases FoundersPassPurchase[]
  invoices              Invoice[]
  testimonialWritten    Testimonial[]
  withdrawals           Withdrawal[]
  ledgerEntries         LedgerEntry[]
  sellerAvailabilities  SellerAvailability[]
  proSubscriptions      ProSubscription[]
}

model SellerAvailability {
  id        String   @id @default(uuid())
  sellerId  String
  dayOfWeek Int // 0-6 -> 7 days
  startTime String
  endTime   String
  timeZone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, dayOfWeek])
}

model FoundersPassPurchase {
  id              String         @id @default(uuid())
  sellerId        String         @unique // JUST ADDED THIS FOR CONSTARINT FOR OEN SELLE PER PASS
  amount          Float
  paymentRefernce String         @unique
  status          StatusFounders @default(PENDING) // PENDING | SUCCESS | FAILED
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model FoundersPassConfig {
  id         String   @id @default(uuid())
  priceNaira Float
  maxPasses  Int      @default(250)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  updatedBy  String? // admin userId, optional audit trail
}

model Gig {
  id           String   @id @default(uuid())
  sellerId     String
  categoryId   String // Changed from String? to required once you migrate
  title        String
  description  String?
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  service      Service  @default(DIGITAL)
  state        State    @default(ACTIVE)
  coverImage   String?
  images       String[]
  video        String?
  avgRating    Float    @default(0)
  totalReviews Int      @default(0)

  deliveryMode GigDeliveryMode @default(DIGITAL)

  // Embedding
  embedding Unsupported("vector(768)")?

  // Ranking
  baseRankingScore Int           @default(0)
  statusFlag       GigStatusFlag @default(NORMAL)
  isRookiePeriod   Boolean       @default(true)
  rookieExpiredAt  DateTime?

  // Relationships
  seller               SellerProfile            @relation(fields: [sellerId], references: [id])
  category             Category                 @relation(fields: [categoryId], references: [id])
  requirementTemplates GigRequirementTemplate[]
  tiers                GigTier[]
  orders               Order[]
  reviews              Review[]
  gigStats             GigStats?
  gigFAQs              GigFAQ[]
  gigCourse            GigCourse?
}

model GigStats {
  id          String   @id @default(uuid())
  gigId       String   @unique
  impressions Int      @default(0)
  clicks      Int      @default(0)
  updatedAt   DateTime @updatedAt

  // relations
  gig Gig @relation(fields: [gigId], references: [id])
}

model GigTier {
  id            String    @id @default(uuid())
  gigId         String
  label         TierLabel
  customName    String?
  description   String
  price         Float
  deliveryDays  Int
  revisionCount Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  sessionLengthMin Int?
  breakLengthMin   Int?
  totalSessions    Int?

  // Relationships
  gig             Gig                 @relation(fields: [gigId], references: [id], onDelete: Cascade)
  quantityPricing TierQuantityPrice[]
  orders          Order[]
  sessionPackages SessionPackage[]

  @@unique([gigId, label]) // a gig can only have ONE TIER not label duplicates
}

model GigRequirementTemplate {
  id         String               @id @default(uuid())
  gigId      String
  question   String // "What is your brand name"
  inputType  RequirementInputType @default(FREE_TEXT)
  options    String[] // Only when inpput_tyoe is multiple
  isRequired Boolean              @default(true)
  order      Int                  @default(0)
  createdAt  DateTime             @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)
}

model TierQuantityPrice {
  id                 String   @id @default(uuid())
  gigTierId          String
  quantity           Int
  totalPrice         Float
  createdAt          DateTime @default(now())
  discountPercentage Float

  gigTier GigTier @relation(fields: [gigTierId], references: [id], onDelete: Cascade)

  @@unique([gigTierId, quantity]) // no duplicate quantity bands per tier
}

model GigCourse {
  id        String   @id @default(uuid())
  gigId     String   @unique
  title     String // Full Concept "Full Qur'an Memorization"
  createdAt DateTime @default(now())

  gig               Gig                @relation(fields: [gigId], references: [id])
  topics            GigTopic[]
  gigSessionUnits   GigSessionUnit[]
  courseEnrollments CourseEnrollment[]
}

model GigTopic {
  id       String @id @default(uuid())
  courseId String
  order    Int
  title    String // Full Concept "Full Qur'an Memorization"

  course       GigCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionUnits GigSessionUnit[]

  @@unique([courseId, order])
}

model GigSessionUnit {
  id               String @id @default(uuid())
  topicId          String
  courseId         String // denormalized, range in course (56-67) cheap
  globalIndex      Int // Position across the WHOLE course i,e 1..128
  title            String
  estimatedMinutes Int    @default(30)

  topic    GigTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  course   GigCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings SessionBooking[]

  @@unique([courseId, globalIndex])
}

model CourseEnrollment {
  id                      String       @id @default(uuid())
  orderId                 String       @unique
  courseId                String
  buyerId                 String
  purchaseType            PurchaseType
  startIndex              Int? // Used for SESSION_RANGE
  endIndex                Int?
  sessionsPerDayPref      Int? // Pacing choice, FULL_COURSE only
  totalSesssionsPurchased Int
  sessionsCompleted       Int          @default(0)
  createdAt               DateTime     @default(now())

  order    Order            @relation(fields: [orderId], references: [id])
  course   GigCourse        @relation(fields: [courseId], references: [id])
  buyer    User             @relation(fields: [buyerId], references: [id])
  bookings SessionBooking[]
}

model SessionPackage {
  id                String             @id @default(uuid())
  orderId           String             @unique
  gigTierid         String
  sessionLengthMin  Int
  breakLengthMin    Int
  totalSessions     Int
  sessionused       Int                @default(0)
  status            PackageStatus      @default(ACTIVE)
  payoutStage       PackagePayoutStage @default(NONE)
  tierOneReleasedAt DateTime?
  tierTwoReleasedAt DateTime?
  finalReleasedAt   DateTime?
  totalAmount       Float?

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gigTier  GigTier          @relation(fields: [gigTierid], references: [id], onDelete: Cascade)
  bookings SessionBooking[]
}

model SessionDispute {
  id                 String               @id @default(uuid())
  bookingId          String               @unique
  raisedById         String
  reason             String
  description        String
  status             SessionDisputeStatus @default(OPEN)
  adminNote          String?
  escalatedDisputeId String?
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking SessionBooking @relation(fields: [bookingId], references: [id])
}

model SessionBooking {
  id                String               @id @default(uuid())
  packageId         String?
  enrollmentId      String?
  sessionUnitId     String?
  callSessionId     String?              @unique // links to CallSession once it happens
  scheduledStart    DateTime
  scheduledEnd      DateTime
  status            SessionBookingStatus @default(SCHEDULED)
  outcome           SessionOutcome       @default(PENDING)
  buyerJoinedAt     DateTime?
  sellerJoinedAt    DateTime?
  buyerLeftAt       DateTime?
  sellerLeftAt      DateTime?
  buyerLeftEarly    Boolean              @default(false)
  sellerLeftEarly   Boolean              @default(false)
  outcomeResolvedAt DateTime?
  outcomeNote       String?
  dispute           SessionDispute?
  roadmapStepId     String? // which topic this session covers

  package     SessionPackage?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  enrollment  CourseEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionUnit GigSessionUnit?   @relation(fields: [sessionUnitId], references: [id])
  callSession CallSession?      @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([enrollmentId])
  @@index([scheduledStart])
}

model SessionOvertimeRequest {
  id            String         @id @default(uuid())
  callSessionId String
  requestedBy   String
  extraMinutes  Int
  amount        Float
  status        OvertimeStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  callSession CallSession @relation(fields: [callSessionId], references: [id])
}

model GigFAQ {
  id        String   @id @default(uuid())
  gigId     String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)
}

// model GigImage

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique // e.g., "programming-tech" or "web-development" for clean URLs
  parentId  String? // If this is null, it's a Main Category. If it has an ID, it's a Subcategory!
  createdAt DateTime @default(now())

  // Self-referencing relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  orders   Order[]

  // The connection back to your Gigs
  gigs Gig[]
}

model Order {
  id         String @id @default(uuid())
  sellerId   String
  buyerId    String
  categoryId String
  gigId      String
  gigTierId  String // the tier that was ordered

  // frozen at order time (SNAPSHOT)
  tierLabelSnapshot     TierLabel
  tierNameSnapshot      String? // customName at time of order, if any
  tierDescription       String
  unitPriceSnapshot     Float
  quantity              Int       @default(1)
  totalPrice            Float // final amount actually charged (unitPrice/bulk price × quantity, frozen)
  commission            Float?
  deliveryDaysSnapshot  Int
  revisionCountSnapshot Int
  requirements          Json?

  deliveryFiles String? //should be String[]

  cancelReason String?

  status                  OrderStatus @default(PENDING)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
  cancelledAt             DateTime?
  requirementsSubmittedAt DateTime?
  paymentReference        String?     @unique

  // Relationships
  buyer            User              @relation(fields: [buyerId], references: [id])
  seller           SellerProfile     @relation(fields: [sellerId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  gigTier          GigTier           @relation(fields: [gigTierId], references: [id])
  gig              Gig               @relation(fields: [gigId], references: [id])
  dispute          Dispute?
  review           Review?
  ledgerEntries    LedgerEntry[]
  orderDeliveries  OrderDelivery[]
  courseEnrollment CourseEnrollment?
  sessionPackage   SessionPackage?
  callSessions     CallSession[]
}

model OrderDelivery {
  id        String          @id @default(uuid())
  orderId   String
  message   String?
  type      GigDeliveryMode @default(DIGITAL)
  files     DeliveryFile[]
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model DeliveryFile {
  id         String   @id @default(uuid())
  deliveryId String?
  fileKey    String
  fileName   String
  fileSize   Int
  createdAt  DateTime @default(now())

  delivery OrderDelivery? @relation(fields: [deliveryId], references: [id])
}

model LedgerEntry {
  id           String            @id @default(uuid())
  userId       String
  withdrawalId String?
  type         LedgerEntryType
  status       LedgerEntryStatus @default(PENDING)
  amount       Decimal           @db.Decimal(12, 2)
  orderId      String?
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // relations
  order           Order?         @relation(fields: [orderId], references: [id])
  withdrawal      Withdrawal?    @relation(fields: [withdrawalId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  sellerProfileId String?

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Withdrawal {
  id                    String            @id @default(cuid())
  userId                String
  amount                Decimal           @db.Decimal(12, 2)
  status                LedgerEntryStatus @default(PENDING)
  paystackTransferCode  String?
  paystackTransferId    String?
  paystackRecipientCode String?
  failureReason         String?
  requestedAt           DateTime          @default(now())
  completedAt           DateTime?

  user            User?          @relation(fields: [userId], references: [id])
  ledgerEntries   LedgerEntry[]
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  sellerProfileId String?

  @@index([userId, status])
}

model OTPVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique // only one review is allowed of course, at DB level enforced
  gigId     String
  buyerId   String
  sellerId  String
  rating    Int
  comment   String
  isFlagged Boolean  @default(false) // spam detection flag (FastAPI)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order         @relation(fields: [orderId], references: [id])
  gig    Gig           @relation(fields: [gigId], references: [id])
  buyer  User          @relation(fields: [buyerId], references: [id])
  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String        @unique // one dispute max
  buyerId      String
  sellerId     String
  reason       DisputeReason
  description  String
  evidenceUrls String[]      @default([])
  status       DisputeStatus @default(OPEN)

  // AI fields (FastAPI work)
  aiSummary        String?
  aiRecommendation String? // "favour_buyer" | "favour_seller" | "escalate"
  aiConfidence     Float?

  // Resolution (populated by admin)
  resolution String?
  resolvedAt DateTime?
  resolvedby String? // admin userId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order  Order         @relation(fields: [orderId], references: [id])
  buyer  User          @relation(fields: [buyerId], references: [id])
  seller SellerProfile @relation(fields: [sellerId], references: [id])
}

model Invoice {
  id               String        @id @default(uuid())
  sellerId         String
  clientName       String
  clientEmail      String? // may not be known until checkout, buyer fills it in
  description      String
  amount           Float
  status           InvoiceStatus @default(PENDING)
  paymentReference String?       @unique
  buyerId          String? // linked once the buyer pays and their User record is created/matched
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  expiresAt        DateTime?

  // Relations
  seller SellerProfile @relation(fields: [sellerId], references: [id])
  buyer  User?         @relation(fields: [buyerId], references: [id])
}

model AgentDecision {
  id           String    @id @default(uuid())
  agentName    AgentName
  entityId     String // the ID of whatever it acted on (disputeId, reviewId, gigId)
  entityType   String // "Dispute" | "Review" | "Gig" — human-readable label for the UI
  decision     String // "favour_buyer" | "spam" | "profile_generated" etc — whatever the agent output
  confidence   Float? // 0.0–1.0, null if the agent doesn't produce a confidence score
  reasoning    String? // the AI's own explanation, if it produced one
  inputSummary String? // short human-readable snapshot of what was fed in
  createdAt    DateTime  @default(now())

  @@index([agentName])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userA    User      @relation("ConversationsAsUserA", fields: [userAId], references: [id])
  userB    User      @relation("ConversationsAsUserB", fields: [userBId], references: [id])
  messages Message[]
  user     User?     @relation(fields: [userId], references: [id])
  userId   String?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  // relations
  sender       User         @relation(fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

model Testimonial {
  id       String @id @default(uuid())
  sellerId String

  buyerId String

  reviewerTitle String?
  text          String   @db.Text
  rating        Int
  createdAt     DateTime @default(now())
  writtenAt     DateTime @updatedAt()

  // relations
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([buyerId])
}

model CallSession {
  id           String        @id @default(uuid())
  roomName     String        @unique
  orderId      String?
  callerId     String
  calleeId     String
  status       CallStatus    @default(PENDING)
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  boardSession BoardSession?
  events       CallEvent[]
  createdAt    DateTime      @default(now())

  caller                  User                     @relation("CallerSessions", fields: [callerId], references: [id])
  callee                  User                     @relation("CalleeSessions", fields: [calleeId], references: [id])
  order                   Order?                   @relation(fields: [orderId], references: [id])
  sessionOvertimeRequests SessionOvertimeRequest[]
  sessionBooking          SessionBooking?
  sessionMaterials        SessionMaterial[]

  @@index([callerId])
  @@index([calleeId])
}

model CallEvent {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  session CallSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model BoardSession {
  id            String    @id @default(uuid())
  callSessionId String    @unique
  mode          BoardMode @default(DIGITAL)
  eventLogUrl   String?
  createdAt     DateTime  @default(now())

  callSession CallSession @relation(fields: [callSessionId], references: [id])
}

model SessionMaterial {
  id            String   @id @default(uuid())
  callSessionId String
  uploadedBy    String
  fileUrl       String
  fileName      String
  fileType      String
  createdAt     DateTime @default(now())

  callSession CallSession @relation(fields: [callSessionId], references: [id])

  @@index([callSessionId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}
