// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// api/node/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS HERE

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  COMPLETED
  FAILED
  CANCELLED
  ACTIVE
  PENDING_PAYMENT
}

// model TestConnection {
//   id        String   @id @default(uuid())
//   createdAt DateTime @default(now())
//   status    String   @default("Successfully Connected!")
// }

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  university      String   @default("Unkown University")
  dateOfBirth     DateTime
  phoneNumber     String   @unique
  isPhoneVerified Boolean  @default(false)
  role            Role     @default(BUYER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  sellerProfile SellerProfile?
  orders        Order[]
}

model SellerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String
  skills       String[]
  rating       Float    @default(0.0)
  paystackSubaccountCode String?
  totalReviews Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  user User  @relation(fields: [userId], references: [id])
  gigs Gig[]
}

model Gig {
  id          String   @id @default(uuid())
  sellerId    String
  categoryId  String   // Changed from String? to required once you migrate
  title       String
  description String
  basePrice   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Relationships
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  orders      Order[]
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique // e.g., "programming-tech" or "web-development" for clean URLs
  parentId    String?    // If this is null, it's a Main Category. If it has an ID, it's a Subcategory!
  createdAt   DateTime   @default(now())

  // Self-referencing relations
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")

  // The connection back to your Gigs
  gigs        Gig[]
}

model Order {
  id               String      @id @default(uuid())
  buyerId          String
  gigId            String
  totalPrice       Float
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  paymentReference String?     @unique

  // Relationships
  user User @relation(fields: [buyerId], references: [id])
  gig   Gig    @relation(fields: [gigId], references: [id])
}
